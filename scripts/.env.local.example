# Copy this file to scripts/.env.local (which is gitignored) and set strong values.
# seed_demo.py reads these from the environment first, then from scripts/.env.local
# (or the project-root .env.local). There is NO hardcoded default, so the seed refuses
# to run until BOTH are provided here or in the environment.
#
# Requirements:
#   - Both are REQUIRED.
#   - Each must be at least 12 characters (matches the Cognito pool password policy).
#   - The two values MUST be different (the admin credential is deliberately separate from
#     the developer credential, so a developer cannot sign in as admin).
TOKENOMICS_DEMO_PASSWORD=change-me-to-a-strong-password             # the six demo developer accounts (portal)
TOKENOMICS_ADMIN_PASSWORD=change-me-to-a-different-strong-password  # the demo admin account (admin console)
