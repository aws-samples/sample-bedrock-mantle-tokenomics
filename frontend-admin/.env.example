#
# Copy to .env.local and fill from the TokenomicsStack CloudFormation outputs.
# All values are safe to expose in a browser bundle (Cognito public app client, API URL).

# ApiEndpoint output (HTTP API base URL, no trailing slash)
VITE_API_URL=https://xxxxxxxxxx.execute-api.us-east-2.amazonaws.com

# UserPoolId output
VITE_USER_POOL_ID=us-east-2_xxxxxxxxx

# UserPoolClientId output (PortalClient)
VITE_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Deployment region
VITE_REGION=us-east-2
